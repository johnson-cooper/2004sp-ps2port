diff --git a/src/world.c b/src/world.c
--- a/src/world.c
+++ b/src/world.c
@@
 int noise(int x, int y) {
-    int n = x + y * 57;
-    int n1 = n << 13 ^ n;
-    int n2 = n1 * (n1 * n1 * 15731 + 789221) + 1376312589 & INT_MAX;
-    return n2 >> 19 & 0xff;
+    // The original Java client relies on defined 32-bit two's-complement wrapping here.
+    // Signed overflow is undefined in C and can change under optimization, so express the
+    // exact intended wrap with uint32_t arithmetic before applying the original INT_MAX mask.
+    uint32_t n = (uint32_t)x + (uint32_t)y * 57u;
+    uint32_t n1 = (n << 13) ^ n;
+    uint32_t n2 = n1 * (n1 * n1 * 15731u + 789221u) + 1376312589u;
+    return (int)((n2 & 0x7fffffffu) >> 19) & 0xff;
 }
