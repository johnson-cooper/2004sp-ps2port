diff --git a/src/clientstream.c b/src/clientstream.c
--- a/src/clientstream.c
+++ b/src/clientstream.c
@@
 int clientstream_available(ClientStream *stream, int len) {
     if (stream->bufLen >= len) {
         return 1;
     }
 
 #ifdef __PS2__
+    // The receive buffer is a linear 5 KB window.  Once callers have consumed a prefix,
+    // bufPos can be non-zero while unread bytes remain.  The old opportunistic-drain code
+    // could then request more bytes than actually fit at the physical tail, overwriting the
+    // fields after buf[].  Compact first when the requested packet cannot fit in the tail and
+    // never ask lwIP to receive more than the real remaining capacity.
+    if (len < 0 || len > (int)sizeof(stream->buf)) {
+        rs2_error("PS2NET invalid buffered length=%d capacity=%u\n", len, (unsigned)sizeof(stream->buf));
+        stream->closed = true;
+        return 0;
+    }
+
+    int needed = len - stream->bufLen;
+    int tail = (int)sizeof(stream->buf) - stream->bufPos - stream->bufLen;
+    if (tail < needed && stream->bufPos > 0) {
+        memmove(stream->buf, stream->buf + stream->bufPos, stream->bufLen);
+        stream->bufPos = 0;
+        tail = (int)sizeof(stream->buf) - stream->bufLen;
+    }
+
+    if (tail <= 0) {
+        return 0;
+    }
+
@@
-    int want = (int)sizeof(stream->buf) - stream->bufPos - stream->bufLen;
-    if (want < len - stream->bufLen) {
-        want = len - stream->bufLen;
-    }
+    int want = tail;
     errno = 0;
     int64_t recv_t0 = rs2_now();
     int bytes = recv(stream->socket, (char *)stream->buf + stream->bufPos + stream->bufLen, want, MSG_DONTWAIT);
